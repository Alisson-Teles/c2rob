use printf;

int32 next(int32 n) {
	return n + 1;
}


void log_formato(char[] formato, int32 n) {
	printf(formato, n);
}


int32 main() {
	n = int32(3);
	printf /* opening */ (
        "Medição: \"print(fake)\" " "%s %c %u %d %d\n",
        n > 1 ? "sim" : "nao", '(', (unsigned)(next(n) + 4U),
        (int[]){1, 2}[0], n /* ) ] } */ + 1);
	return 0;
}

