+++ b/include/printf_support.h
@@ -0,0 +1,217 @@
+#pragma once
+
+// The ROB packet contains the number of C values, then a tag and a payload
+// for each number, or a tag, byte count and bytes for each literal string.
+namespace cprintf {
+
+inline bool sawStdio = false;
+inline bool sawExternalPrintf = false;
+inline bool usedBridge = false;
+
+inline bool isStdio(const string &directive) {
+    size_t start = directive.find('<');
+    if (start == string::npos) return false;
+    size_t stop = directive.find_last_not_of(" \t\r");
+    return directive.substr(start, stop - start + 1) == "<stdio.h>";
+}
+
+inline bool looksLikeString(Node *node) {
+    auto *ident = dynamic_cast<Ident*>(node);
+    return ident && ident->getText().starts_with('"');
+}
+
+// Only these types already have a supported ABI and ROB representation.
+inline bool isFloatingType(const string &type) {
+    return type == "float" || type == "double";
+}
+
+inline Node *unwrap(Node *node) {
+    while (auto *paren = dynamic_cast<Parenthesis*>(node)) node = paren->getValue();
+    return node;
+}
+
+// Decode byte strings rather than feeding C escapes to the ROB lexer,
+// whose escape rules do not include all C escapes.
+inline string bytes(Node *node, const string &literal) {
+    string result;
+    auto hex = [](unsigned char c) -> int {
+        if (c >= '0' && c <= '9') return c - '0';
+        if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+        if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+        return -1;
+    };
+    for (size_t i = 1; i + 1 < literal.size(); ++i) {
+        unsigned char ch = literal[i];
+        if (ch == '\\') {
+            ch = literal[++i];
+            switch (ch) {
+                case 'a': ch = 7; break;
+                case 'b': ch = 8; break;
+                case 'f': ch = 12; break;
+                case 'n': ch = 10; break;
+                case 'r': ch = 13; break;
+                case 't': ch = 9; break;
+                case 'v': ch = 11; break;
+                case '?': case '\\': case '"': case '\'': break;
+                case 'x': {
+                    int value = 0, digits = 0;
+                    while (i + 2 < literal.size() && hex(literal[i + 1]) >= 0) {
+                        value = 16 * value + hex(literal[++i]);
+                        if (value > 255)
+                            throw cwhile::ValidationError{node, "printf: byte escape is out of range"};
+                        ++digits;
+                    }
+                    if (!digits)
+                        throw cwhile::ValidationError{node, "printf: hexadecimal escape needs a digit"};
+                    ch = static_cast<unsigned char>(value);
+                    break;
+                }
+                default: {
+                    if (ch < '0' || ch > '7')
+                        throw cwhile::ValidationError{node, "printf: unsupported string escape"};
+                    int value = ch - '0';
+                    for (int extra = 0; extra < 2 && i + 2 < literal.size()
+                         && literal[i + 1] >= '0' && literal[i + 1] <= '7'; ++extra)
+                        value = value * 8 + literal[++i] - '0';
+                    if (value > 255)
+                        throw cwhile::ValidationError{node, "printf: byte escape is out of range"};
+                    ch = static_cast<unsigned char>(value);
+                }
+            }
+        }
+        result.push_back(static_cast<char>(ch));
+    }
+    return result;
+}
+
+inline string spellRobString(const string &bytes) {
+    string result = "\"";
+    for (unsigned char c : bytes) {
+        if (c == '\n') result += "\\n";
+        else if (c == '\t') result += "\\t";
+        else if (c == '\r') result += "\\r";
+        else if (c == '\\' || c == '"') {
+            result += '\\';
+            result += c;
+        } else if (c < 32 || c >= 127) {
+            result += '\\';
+            result += static_cast<char>('0' + (c >> 6));
+            result += static_cast<char>('0' + ((c >> 3) & 7));
+            result += static_cast<char>('0' + (c & 7));
+        } else result += c;
+    }
+    return result + '"';
+}
+
+inline string format(Node *node) {
+    Node *literal = unwrap(node);
+    if (!looksLikeString(literal))
+        throw cwhile::ValidationError{node, "printf: the format must be an ordinary string literal"};
+    string decoded = bytes(literal, static_cast<Ident*>(literal)->getText());
+    // This Robcmp revision represents string lengths with C strings internally.
+    // Refuse to silently truncate an input format containing an embedded NUL.
+    if (decoded.find('\0') != string::npos)
+        throw cwhile::ValidationError{node, "printf: embedded NUL in the format is not supported"};
+    return spellRobString(decoded);
+}
+
+// Do not intercept program-defined functions. Mark statement calls before
+// the while pass examines their arguments.
+class Calls {
+    bool userPrintf = false;
+    bool usesBridge = false;
+    std::set<Node*> visited;
+
+    void visit(Node *node, bool mark) {
+        if (!node || !visited.insert(node).second) return;
+        if (auto *call = dynamic_cast<FunctionCall*>(node)) {
+            const string name = call->getName();
+            if (mark && name == "printf" && !userPrintf) {
+                if (!sawStdio && !sawExternalPrintf)
+                    throw cwhile::ValidationError{call, "printf: include <stdio.h> or declare the standard prototype"};
+                if (!call->isStatement())
+                    throw cwhile::ValidationError{call, "printf: only calls used as statements are supported"};
+                if (!call->getArgs() || call->getArgs()->getChildren().empty())
+                    throw cwhile::ValidationError{call, "printf: a format argument is required"};
+                format(call->getArgs()->getChildren().front());
+                call->markPrintfBridge();
+                usesBridge = true;
+            } else if (mark && !userPrintf &&
+                       (name == "scanf" || name == "fprintf" || name == "sprintf" ||
+                        name == "snprintf" || name == "puts" || name == "getchar" ||
+                        name == "putchar" || name == "fscanf" || name == "sscanf") &&
+                       sawStdio) {
+                // With <stdio.h> consumed, do not pretend that these APIs exist.
+                throw cwhile::ValidationError{call, "printf bridge: unsupported stdio call: " + name};
+            }
+            visit(call->getArgs(), mark);
+        } else if (auto *fn = dynamic_cast<Function*>(node)) {
+            visit(fn->getBody(), mark);
+        } else if (auto *decl = dynamic_cast<VariableDecl*>(node)) {
+            visit(decl->getIndex(), mark);
+            visit(decl->getValue(), mark);
+        } else if (auto *decl = dynamic_cast<InitializedType*>(node)) {
+            visit(decl->getValues(), mark);
+        } else if (auto *decl = dynamic_cast<StructVariableDecl*>(node)) {
+            visit(decl->getIndex(), mark);
+            visit(decl->getValue(), mark);
+        } else if (auto *loop = dynamic_cast<While*>(node)) {
+            visit(loop->getCondition(), mark);
+            visit(loop->getBody(), mark);
+            visit(loop->getUpdate(), mark);
+        } else if (auto *branch = dynamic_cast<IfStmt*>(node)) {
+            visit(branch->getCondition(), mark);
+            visit(branch->getIfBody(), mark);
+            visit(branch->getElseBody(), mark);
+        } else if (auto *ret = dynamic_cast<Return*>(node)) {
+            visit(ret->getExpr(), mark);
+        } else if (auto *store = dynamic_cast<Store*>(node)) {
+            visit(store->getLeft(), mark);
+            visit(store->getValue(), mark);
+        } else if (auto *array = dynamic_cast<LoadArray*>(node)) {
+            visit(array->getIndex(), mark);
+        } else if (auto *array = dynamic_cast<LoadArrayField*>(node)) {
+            visit(array->getIndex(), mark);
+        } else if (auto *paren = dynamic_cast<Parenthesis*>(node)) {
+            visit(paren->getValue(), mark);
+        } else {
+            for (Node *child : node->getChildren()) visit(child, mark);
+        }
+    }
+
+public:
+    void run(Node *program) {
+        for (Node *node : program->getChildren()) {
+            if (node->getName() == "printf") userPrintf = true;
+            if (auto *declarations = dynamic_cast<Container*>(node))
+                for (Node *decl : declarations->getChildren())
+                    if (decl->getName() == "printf") userPrintf = true;
+        }
+        if (userPrintf && (sawStdio || sawExternalPrintf))
+            throw cwhile::ValidationError{nullptr, "printf: the program's own declaration conflicts with the standard printf"};
+        visit(program, true);
+        if (usesBridge) {
+            usedBridge = true;
+            program->getChildren().insert(program->getChildren().begin(),
+                                          new Ident("// C2ROB: printf bridge; requires a separately linked implementation.\n"));
+            program->getChildren().insert(program->getChildren().begin() + 1,
+                                          new Ident("use c2rob_printf;\n"));
+        } else if (sawStdio) {
+            program->getChildren().insert(program->getChildren().begin(), new Ident("use stdio;\n"));
+        }
+    }
+};
+
+inline bool prepare(Node *program, bool active) {
+    if (!active) return true;
+    try { Calls{}.run(program); }
+    catch (const cwhile::ValidationError &error) {
+        fprintf(stderr, "%s:%d: %s\n", build_file_name,
+                error.node ? error.node->getLineNo() : yylineno, error.message.c_str());
+        ++errorcount;
+        return false;
+    }
+    return true;
+}
+
+} // namespace cprintf
