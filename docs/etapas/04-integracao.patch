--- /dev/null
+++ b/test/unit/printf_packet_probe.c
@@ -0,0 +1,75 @@
+/* Test-only oracle. The tested fixtures have known format/argument shapes.
+   The real ROB stub is linked independently in printf_stub_link. */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum {
+    signed32 = 1, unsigned32, signed64, unsigned64, floating64, literal_string
+};
+
+static void check(int ok) {
+    if (!ok) {
+        fputs("invalid printf bridge packet\n", stderr);
+        abort();
+    }
+}
+
+static uint64_t next(const uint64_t *packet, uint32_t size, uint32_t *i) {
+    check(*i < size);
+    return packet[(*i)++];
+}
+
+/* ROB appends the sizes of array parameters after the explicit arguments. */
+int c2rob_test_printf(const char *format_bytes, const uint64_t *packet,
+                      uint32_t format_size, uint32_t packet_size) {
+    check(format_size < 256 && packet_size > 0);
+    char format[256], str[64] = {0};
+    memcpy(format, format_bytes, format_size);
+    format[format_size] = '\0';
+    uint64_t count = packet[0], tags[16], values[16];
+    double doubles[16];
+    uint32_t i = 1;
+    check(count <= 16);
+    for (uint64_t k = 0; k < count; ++k) {
+        tags[k] = next(packet, packet_size, &i);
+        values[k] = next(packet, packet_size, &i);
+        if (tags[k] == floating64) memcpy(&doubles[k], &values[k], sizeof(double));
+        else if (tags[k] == literal_string) {
+            check(values[k] < sizeof str);
+            for (uint64_t j = 0; j < values[k]; ++j) {
+                uint64_t byte = next(packet, packet_size, &i);
+                check(byte <= 255);
+                str[j] = (char)byte;
+            }
+            str[values[k]] = '\0';
+        } else check(tags[k] >= signed32 && tags[k] <= unsigned64);
+    }
+    check(i == packet_size);
+
+    if (!count) return fputs(format, stdout);
+    if (!strcmp(format, "%d %u %lld %llu %.2f %.2f %d %s %%\n")) {
+        const uint64_t expected[] = {signed32, unsigned32, signed64, unsigned64,
+                                     floating64, floating64, signed32, literal_string};
+        check(count == 8 && !memcmp(tags, expected, sizeof expected));
+        return printf(format, (int)(int32_t)values[0], (unsigned)values[1],
+                      (long long)(int64_t)values[2], (unsigned long long)values[3],
+                      doubles[4], doubles[5], (int)(int32_t)values[6], str);
+    }
+    if (!strcmp(format, "a%d %s\n")) {
+        check(count == 2 && tags[0] == signed32 && tags[1] == literal_string);
+        return printf(format, (int)(int32_t)values[0], str);
+    }
+    if (!strcmp(format, "ação: %.17g %.17g %.17g %c\n")) {
+        check(count == 4 && tags[0] == floating64 && tags[1] == floating64 &&
+              tags[2] == floating64 && tags[3] == signed32);
+        return printf(format, doubles[0], doubles[1], doubles[2], (int)(int32_t)values[3]);
+    }
+    for (uint64_t k = 0; k < count; ++k) check(tags[k] == signed32);
+    if (count == 1) return printf(format, (int)(int32_t)values[0]);
+    if (count == 2) return printf(format, (int)(int32_t)values[0], (int)(int32_t)values[1]);
+    check(count == 4);
+    return printf(format, (int)(int32_t)values[0], (int)(int32_t)values[1],
+                  (int)(int32_t)values[2], (int)(int32_t)values[3]);
+}
