+#include <stdio.h>
+
+int checks = 0;
+
+int check(int n) {
+    checks++;
+    return n;
+}
+
+int main(void) {
+    int i = 0, seen = 0;
+    while (i < 3) {
+        if (i == 1)
+            printf("middle %d\n", i);
+        else
+            printf("edge %d\n", i + 1);
+        i++;
+    }
+    for (i = 0; i < 2; i++)
+        printf("loop %d\n", i);
+    if (i == 2)
+        printf("done %d\n", i == 2 || check(0));
+    printf("checks: %d %d\n", seen && check(1), (i == 2) && (check(0) || check(7)));
+    return checks;
+}
